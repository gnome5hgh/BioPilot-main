# BioPilot 部署引导 —— 复制为 .env 后按部署修改（.env 被 gitignore，不会提交）。
#
# 运行时配置（模型、检索参数、安全档位等）已经迁入 MySQL，由网页「设置」维护；
# 本文件只保留「进程启动前必须知道、且跟这台机器/这套部署绑定」的值。
# 覆盖顺序：代码默认值 < 数据库 < config.yaml（仅引导层）< .env < 操作系统环境变量。

# ── 模型密钥（可选；留空则在设置页填写，env 优先级最高并会锁住页面字段）──
BIOPILOT_LLM_API_KEY=
BIOPILOT_RAG_EMBEDDING_API_KEY=

# ── 运行数据 ──────────────────────────────────────────────────────────────
# 运行时数据根：默认仓库内 .biopilot（日志/pid、用户缓存、scratch、工具结果都在这里）
BIOPILOT_RUNTIME_WORKSPACE=.biopilot
# 按用户隔离的派生缓存（附件副本、技能物化）；留空 = <workspace>/user-cache
BIOPILOT_RUNTIME_USER_CACHE_DIR=
# 记忆/会话/配置真相源的 MySQL（容器实例发布在宿主 3307）
BIOPILOT_MEMORY_MYSQL_DSN=mysql://root@127.0.0.1:3307/biopilot
# Agent 插件扫描目录
BIOPILOT_RUNTIME_AGENTS_DIR=agents

# ── Java 平台 ─────────────────────────────────────────────────────────────
BIOPILOT_PLATFORM_BASE_URL=http://127.0.0.1:8080
# 与 Java 入站校验共用的内部 token（生产必须配置）
BIOPILOT_INTERNAL_TOKEN=

# ── 产物路径（可选；留空由工作区派生）─────────────────────────────────────
# 笔记定稿进网页文档编辑器、论文由平台 OSS 提供，二者不再需要本地目录。
BIOPILOT_CORPUS_ANALYSIS_DIR=
BIOPILOT_CORPUS_RESEARCH_DIR=

# ── 向量库与对象存储 ──────────────────────────────────────────────────────
BIOPILOT_RAG_STORAGE_URI=http://localhost:19530
BIOPILOT_RAG_STORAGE_COLLECTION=biopilot
BIOPILOT_RAG_STORAGE_MINIO_ENDPOINT=localhost:9000
BIOPILOT_RAG_STORAGE_MINIO_ACCESS_KEY=minioadmin
BIOPILOT_RAG_STORAGE_MINIO_SECRET_KEY=minioadmin
# 论文/文件/文档/技能/图表原图/工具结果共用一个桶，靠前缀分域
BIOPILOT_RAG_STORAGE_MINIO_BUCKET=biopilot
BIOPILOT_RAG_STORAGE_MINIO_SECURE=false
# 对象存储不可用时，大工具结果的本地回退目录（留空 = <workspace>/tool-results）
BIOPILOT_COMPACTION_TOOL_RESULTS_LOCAL_DIR=

# ── 配置加密（可选）──────────────────────────────────────────────────────
# 密钥字段（LLM/RAG/判定服务的 api_key）用 AES-GCM 加密后存库。
# 留空时会在 <workspace>/config.key 自动生成（0600）；生产建议显式配置并备份，
# 丢失主密钥后已存密钥无法解密，只能重新填写。
# 生成：python -c "import base64,os;print(base64.urlsafe_b64encode(os.urandom(32)).decode())"
# BIOPILOT_CONFIG_KEY=

# ── 进程参数（不属于配置树）───────────────────────────────────────────────
BIOPILOT_WEB_HOST=127.0.0.1
BIOPILOT_WEB_PORT=8300
