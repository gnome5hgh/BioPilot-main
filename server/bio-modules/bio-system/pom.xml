<?xml version="1.0" encoding="UTF-8"?>
<project xmlns="http://maven.apache.org/POM/4.0.0"
         xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
         xsi:schemaLocation="http://maven.apache.org/POM/4.0.0 http://maven.apache.org/xsd/maven-4.0.0.xsd">
  <modelVersion>4.0.0</modelVersion>
  <parent>
    <groupId>com.biopilot</groupId>
    <artifactId>bio-modules</artifactId>
    <version>1.0.0</version>
  </parent>
  <artifactId>bio-system</artifactId>
  <dependencies>
    <dependency>
      <groupId>com.biopilot</groupId>
      <artifactId>bio-common-core</artifactId>
    </dependency>
    <!-- 删户编排：同步调用适配层 /internal/users/*，失败即降级 -->
    <dependency>
      <groupId>com.biopilot</groupId>
      <artifactId>bio-common-web</artifactId>
    </dependency>
    <!-- 登录态与角色注解（Auth/管理端控制器、StpInterfaceImpl） -->
    <dependency>
      <groupId>com.biopilot</groupId>
      <artifactId>bio-common-satoken</artifactId>
    </dependency>
    <!-- 删户时清理 OSS 对象（先删行、再删对象） -->
    <dependency>
      <groupId>com.biopilot</groupId>
      <artifactId>bio-common-oss</artifactId>
    </dependency>
    <dependency>
      <groupId>com.baomidou</groupId>
      <artifactId>mybatis-plus-spring-boot3-starter</artifactId>
    </dependency>
    <dependency>
      <groupId>org.springframework.boot</groupId>
      <artifactId>spring-boot-starter-web</artifactId>
    </dependency>
    <!-- 密码摘要只用 crypto 模块（不引整个 security 过滤链，链归 bio-admin 的 Sa-Token 管） -->
    <dependency>
      <groupId>org.springframework.security</groupId>
      <artifactId>spring-security-crypto</artifactId>
    </dependency>
    <!-- SysUser 用 Jackson 注解做口令摘要隐藏与 ID 字符串化 -->
    <dependency>
      <groupId>com.fasterxml.jackson.core</groupId>
      <artifactId>jackson-databind</artifactId>
    </dependency>
  </dependencies>
</project>
