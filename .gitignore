# Python
__pycache__/
*.py[cod]
*.egg-info/
dist/
build/
.pytest_cache/

# Virtual environments
.venv/
venv/
env/

# IDE
.vscode/
.idea/
*.swp
*.swo

# OS
.DS_Store
Thumbs.db

# Runtime data：运行时数据根收在 .biopilot/ 下（记忆/审计/会话历史/Milvus 卷 .biopilot/infra/），
# 只反选入库静态资产目录（意图知识库 intent/）与本目录自己的 manifest。
# 注意：反选必须用 `.biopilot/*` 排除内容而非 `.biopilot/` 排除目录本身，
# 否则 ! 规则对父目录被排除的子路径无效（与下面的 .claude/ 同一坑）。
.biopilot/*
!.biopilot/AGENTS.md
!.biopilot/intent/

# Documentation (not version controlled)；只忽略仓库根的设计文档，
# 别用未锚定的 docs/——那会把 biopilot/tools/docs/（代码包）一起忽略掉
/docs/

# 本地暂存：ticket 拆解、临时草稿等中间产物，不入库
.scratch/

# Claude Code Memory Bank — 静态资产进 git（settings.json/scripts/稳定文档），易变/个人文件保持忽略
# 注意：反选子文件必须用 .claude/* 排除内容而非 .claude/ 排除目录本身，否则 ! 规则对父目录被排除的子路径无效
.claude/*
!.claude/settings.json
!.claude/scripts/
!.claude/scripts/*
!.claude/SCOPE.md
!.claude/SYSTEM.md
!.claude/DECISIONS.md
!.claude/MEMORY_BANK.md

# 测试和脚本
/tests/
/scripts/

# 执行工作区（SDD 账本等临时产物）
.superpowers/

# ZCode 工作区（本地会话/配置，不入库）
.zcode/

# Environment
.env
.env.local
config.yaml
# 迁移旧配置时生成的备份（含密钥），确认迁移无误后删除
config.yaml.bak

# 仓库级配置文件本地化（含本文件自身），不入库
# AGENTS.md 已转入 git 管理（根 manifest + 子目录逐级 manifest）；CLAUDE.md 为本地薄指针
CLAUDE.md
.zcodeignore
.gitignore

# Java 构建产物（server/ 源码入库，target 不入库）
server/**/target/
server/**/*.class
